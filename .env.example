# MongoDB (optional): pilot accounts and the global leaderboard.
# Without it the app runs in Local Mode: accounts and flight logs stay in the
# browser's localStorage. Include the credentials; the app uses the
# "flight_simulator" database.
MONGODB_URI=""

# Media storage (optional): any S3-compatible bucket for custom liveries and
# screenshots. Without it, development servers save uploads to public/uploads;
# production servers refuse uploads until a bucket is set.
# The bucket must allow public reads and CORS GET from your site so the 3D view
# can load a livery as a texture.
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT="https://s3.your-provider.example"
STORAGE_PUBLIC_URL="https://media.your-domain.example"
# Signing region; "auto" works for most S3-compatible providers.
STORAGE_REGION="auto"
